# Secrets live here, never in project.config.json (which gets committed and
# emailed to clients).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Gates POST /ingest and POST /upload behind an "X-Admin-Token" header.
# Required before exposing the API publicly -- unset means those endpoints
# are open to anyone who can reach the port. Not needed for local dev.
APP_ADMIN_TOKEN=

# Any Settings field can be overridden with APP_<FIELD>, which beats editing
# config per environment:
# APP_LLM_PROVIDER=openai
# APP_LLM_MODEL=gpt-4.1-mini
# APP_EMBEDDING_PROVIDER=openai
# APP_EMBEDDING_DIM=1536
# APP_MAX_COST_USD_PER_RUN=0.25
